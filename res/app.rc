#include <windows.h>
#include "..\src\resource.h"

IDI_APP_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vansh Tools"
            VALUE "FileDescription",  "Cursor_Vansh for Windows"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Cursor_Vansh"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Vansh"
            VALUE "OriginalFilename", "Cursor_Vansh.exe"
            VALUE "ProductName",      "Cursor_Vansh"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
